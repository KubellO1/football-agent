  "_meta": {
    "version": "1.0.0",
    "created_at": "2026-07-12",
    "description": "Production competition whitelist for football-agent. Only whitelisted competitions are analyzed, consume API quota, appear on Dashboard, and generate BET/WATCH/NO BET predictions. All others are skipped with SKIPPED_UNSUPPORTED_COMPETITION.",
    "maintainer_note": "To add a competition, add an entry under the appropriate category below. To temporarily disable a competition without removing it, set its 'enabled' field to false."
  },
  "filter_mode": "whitelist",
  "excluded_categories": {
    "youth_competitions": true,
    "reserve_leagues": true,
    "womens_competitions": true,
    "friendly_matches": true,
    "exhibition_matches": true,
    "amateur_leagues": true,
    "regional_leagues": true,
    "very_low_divisions": true,
    "competitions_without_reliable_odds": true,
    "competitions_without_sufficient_data": true,
    "note": "Women's competitions can be enabled by setting womens_competitions to false and adding relevant entries to the whitelist."
