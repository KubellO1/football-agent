# ---------------------------------------------------------------------------
# Application
# ---------------------------------------------------------------------------
APP_NAME="Football Agent"
ENVIRONMENT=local            # local | staging | production
DEBUG=true
API_V1_PREFIX=/api/v1
LOG_LEVEL=INFO

# ---------------------------------------------------------------------------
# PostgreSQL
# ---------------------------------------------------------------------------
POSTGRES_USER=football
POSTGRES_PASSWORD=changeme
POSTGRES_DB=football
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
# Full async DSN (overrides the parts above if set):
# DATABASE_URL=postgresql+asyncpg://football:changeme@localhost:5432/football

# ---------------------------------------------------------------------------
# Redis
# ---------------------------------------------------------------------------
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_DB=0
# REDIS_URL=redis://localhost:6379/0

# ---------------------------------------------------------------------------
# AI reasoning (Claude)
# ---------------------------------------------------------------------------
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-4-8

