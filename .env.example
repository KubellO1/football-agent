# ---------------------------------------------------------------------------
# Application
# ---------------------------------------------------------------------------
APP_NAME="Football Agent"
ENVIRONMENT=local            # local | staging | production
DEBUG=true
API_V1_PREFIX=/api/v1
LOG_LEVEL=INFO

# ---------------------------------------------------------------------------
# PostgreSQL
# ---------------------------------------------------------------------------
POSTGRES_USER=football
POSTGRES_PASSWORD=changeme
POSTGRES_DB=football
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
# Full async DSN (overrides the parts above if set):
# DATABASE_URL=postgresql+asyncpg://football:changeme@localhost:5432/football

# ---------------------------------------------------------------------------
# Redis
# ---------------------------------------------------------------------------
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_DB=0
# REDIS_URL=redis://localhost:6379/0

# ---------------------------------------------------------------------------
# AI reasoning (OpenAI)
# ---------------------------------------------------------------------------
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.6-sol
OPENAI_REASONING_EFFORT=high

# ---------------------------------------------------------------------------
# External data providers
# ---------------------------------------------------------------------------
# API-Football — fixtures, results, league data. Get a key at https://www.api-football.com/
API_FOOTBALL_KEY=
API_FOOTBALL_BASE_URL=https://v3.football.api-sports.io

# The Odds API — bookmaker odds. Get a key at https://the-odds-api.com/
ODDS_API_KEY=
ODDS_API_BASE_URL=https://api.the-odds-api.com/v4

# Odds-API.io — primary bookmaker odds provider. Get a key at https://odds-api.io/
ODDS_API_IO_API_KEY=
ODDS_API_IO_BASE_URL=https://api.odds-api.io/v3

# Shared HTTP behaviour for all providers
PROVIDER_TIMEOUT_SECONDS=10.0
PROVIDER_MAX_RETRIES=3
PROVIDER_BACKOFF_BASE_SECONDS=0.5

# Odds ingestion — The Odds API sport keys to fetch (JSON list) + bookmaker regions.
# Production should enumerate the soccer leagues you care about, e.g.
# ODDS_SPORT_KEYS=["soccer_epl","soccer_uefa_champs_league","soccer_spain_la_liga"]
ODDS_SPORT_KEYS=["soccer_epl"]
ODDS_REGIONS=["eu"]
ODDS_MATCH_TOLERANCE_MINUTES=180

# Scheduled daily worker
WORKER_SCHEDULE_TIME=06:00      # daily run time, HH:MM (UTC)
WORKER_RUN_ON_START=false       # also run once immediately on startup
